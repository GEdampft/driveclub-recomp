// VR (dcport-vr): sharpening after DLSS, one eye's layer (DLSS 3.1+ ignores its own sharpness). RCAS in HDR as
// taa_sharpen.comp (a local scale normalises the neighbourhood); strength 0..1. The input is the DLSS result
// (RGBA16F); the output the game's lit scene itself (R11G11B10F, DLAA: it replaces the copy) or a second RGBA16F
// image (upscaling: what the game's passes then read).
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba16f) uniform readonly image2D src_img;
#ifdef OUT_R11G11B10
layout(binding = 1, r11f_g11f_b10f) uniform writeonly image2D dst_img;
#else
layout(binding = 1, rgba16f) uniform writeonly image2D dst_img;
#endif
layout(push_constant) uniform Params {
    vec2 size;
    float strength;
};
#define A_GPU 1
#define A_GLSL 1
#include "../../host_shaders/fsr/ffx_a.h"
#define FSR_RCAS_F 1
#define FSR_RCAS_DENOISE 1
float color_scale;
vec3 loadColor(ivec2 p) {
    return max(imageLoad(src_img, clamp(p, ivec2(0), ivec2(size) - 1)).rgb, vec3(0));
}
AF4 FsrRcasLoadF(ASU2 p) { return vec4(loadColor(p) / color_scale, 1); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "../../host_shaders/fsr/ffx_fsr1.h"
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(size.x) || p.y >= int(size.y)) {
        return;
    }
    float amount = clamp(strength, 0.0, 1.0);
    vec3 center = loadColor(p);
    vec3 left = loadColor(p + ivec2(-1, 0)), right = loadColor(p + ivec2(1, 0));
    vec3 top = loadColor(p + ivec2(0, -1)), bottom = loadColor(p + ivec2(0, 1));
    vec3 peak = max(center, max(max(left, right), max(top, bottom)));
    color_scale = max(1.0, max(peak.r, max(peak.g, peak.b)));
    vec3 low = min(center, min(min(left, right), min(top, bottom)));
    if (amount == 0.0 || all(lessThanEqual(peak - low, vec3(1e-6 * color_scale)))) {
        imageStore(dst_img, p, vec4(center, 1));
        return;
    }
    uvec4 constants = uvec4(floatBitsToUint(exp2(-2.0 * (1.0 - amount))), 0, 0, 0);
    vec3 sharpened;
    FsrRcasF(sharpened.r, sharpened.g, sharpened.b, uvec2(p), constants);
    imageStore(dst_img, p, vec4(clamp(sharpened * color_scale, vec3(0), vec3(color_scale)), 1));
}
